<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Referans Rentecar | Premium Araç Kiralama</title>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #050505;
            --surface-color: #111111;
            --gold-primary: #D4AF37;
            --gold-dim: #8A7322;
            --text-light: #E0E0E0;
            --text-muted: #888888;
            --danger: #CF6679;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Montserrat', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body, html {
            background-color: var(--bg-color);
            color: var(--text-light);
            height: 100%;
            overflow: hidden; /* Kontrol snap container'da */
        }

        /* --- PRE-LOADER --- */
        #preloader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: #000;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: opacity 0.8s ease-out;
        }

        .jaguar-loader-svg {
            width: 120px;
            fill: var(--gold-primary);
            animation: sprint 1s infinite alternate ease-in-out;
        }

        @keyframes sprint {
            0% { transform: scaleX(1) translateY(0); }
            100% { transform: scaleX(1.1) translateY(-10px); }
        }

        .loader-text {
            margin-top: 20px;
            color: var(--gold-primary);
            font-weight: 200;
            letter-spacing: 4px;
            font-size: 14px;
            text-transform: uppercase;
        }

        /* --- MAIN LAYOUT & SNAP SCROLL --- */
        .snap-container {
            height: 100vh;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            scroll-behavior: smooth;
        }

        /* %20 PEEK MANTIĞI: Her bölüm 80vh olacak, böylece alttaki aracın %20'si görünecek */
        .snap-section {
            height: 80vh;
            scroll-snap-align: start;
            position: relative;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
            display: flex;
            flex-direction: column;
        }

        .full-screen-section {
            height: 100vh; /* Form bölümü için tam ekran */
            scroll-snap-align: start;
            padding: 40px 20px;
        }

        /* --- HEADER & FILTERS --- */
        .header {
            position: fixed;
            top: 0;
            width: 100%;
            background: linear-gradient(to bottom, rgba(5,5,5,1) 0%, rgba(5,5,5,0) 100%);
            z-index: 100;
            padding: 20px 0 10px 0;
        }

        .header-title {
            text-align: center;
            font-size: 12px;
            font-weight: 300;
            color: var(--text-muted);
            letter-spacing: 1px;
            margin-bottom: 15px;
        }

        .filters-wrapper {
            display: flex;
            overflow-x: auto;
            padding: 0 20px;
            gap: 15px;
            scrollbar-width: none; /* Firefox */
        }
        .filters-wrapper::-webkit-scrollbar { display: none; /* Chrome */ }

        .filter-chip {
            padding: 8px 20px;
            border: 1px solid var(--text-muted);
            border-radius: 20px;
            font-size: 12px;
            font-weight: 300;
            color: var(--text-muted);
            white-space: nowrap;
            transition: all 0.3s ease;
        }

        .filter-chip.active {
            border-color: var(--gold-primary);
            color: var(--gold-primary);
            background-color: rgba(212, 175, 55, 0.1);
        }

        /* --- CAR 360 VIEWER --- */
        .car-container {
            flex: 1;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding-top: 60px; /* Header boşluğu */
        }

        .canvas-360 {
            width: 100%;
            max-width: 600px;
            height: 40vh;
            cursor: grab;
            touch-action: none; /* Kaydırma çakışmasını önler */
        }

        .car-details {
            width: 100%;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .brand-model {
            font-size: 24px;
            font-weight: 400;
            color: #fff;
            letter-spacing: 2px;
            margin-bottom: 5px;
        }

        .segment-jaguar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
        }

        .segment-icon {
            width: 24px;
            fill: var(--gold-primary);
        }

        .lux-jaguar {
            animation: fast-run 0.5s infinite alternate ease-in-out;
            fill: var(--gold-primary);
        }

        .std-jaguar {
            animation: normal-run 1s infinite alternate ease-in-out;
            fill: var(--text-muted);
        }

        @keyframes fast-run { 0% { transform: translateX(-5px); } 100% { transform: translateX(5px); } }
        @keyframes normal-run { 0% { transform: translateX(-2px); } 100% { transform: translateX(2px); } }

        .price-tag {
            font-size: 28px;
            font-weight: 200;
            color: var(--gold-primary);
            margin-bottom: 20px;
        }

        .price-currency {
            font-size: 14px;
        }

        .specs-grid {
            display: flex;
            gap: 30px;
            justify-content: center;
        }

        .spec-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

        .spec-icon {
            width: 20px;
            fill: var(--text-muted);
        }

        .spec-value {
            font-size: 12px;
            font-weight: 300;
            color: var(--text-light);
        }

        /* --- 2'Lİ KUTUCUK (GRID) --- */
        .dual-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            height: 100%;
            width: 100%;
        }

        .dual-item {
            border-right: 1px solid rgba(212, 175, 55, 0.1);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px 10px;
            position: relative;
        }

        .dual-item:last-child {
            border-right: none;
        }

        .dual-canvas {
            width: 100%;
            height: 25vh;
            touch-action: none;
        }

        .dual-details {
            text-align: center;
            margin-top: 15px;
        }

        .dual-brand {
            font-size: 16px;
            font-weight: 400;
            margin-bottom: 5px;
        }

        .dual-price {
            font-size: 18px;
            color: var(--gold-primary);
            font-weight: 300;
        }

        /* --- FORM SECTION --- */
        .lead-form-container {
            max-width: 500px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            justify-content: center;
            height: 100%;
        }

        .value-prop {
            text-align: center;
            margin-bottom: 30px;
        }

        .value-prop p {
            font-size: 13px;
            font-weight: 300;
            line-height: 1.6;
            color: var(--text-light);
        }

        .value-prop span {
            color: var(--gold-primary);
            font-weight: 400;
        }

        .payment-icons {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .payment-icons svg {
            height: 24px;
            fill: var(--text-muted);
        }

        .form-group {
            position: relative;
            margin-bottom: 20px;
        }

        .form-input {
            width: 100%;
            background: transparent;
            border: none;
            border-bottom: 1px solid var(--text-muted);
            padding: 10px 0;
            color: #fff;
            font-size: 16px;
            font-weight: 300;
            outline: none;
            transition: border-color 0.3s;
        }

        .form-input:focus {
            border-bottom-color: var(--gold-primary);
        }

        .form-input::placeholder {
            color: rgba(255,255,255,0.3);
        }

        .row-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .contact-method {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
        }

        .method-btn {
            flex: 1;
            background: transparent;
            border: 1px solid var(--text-muted);
            color: var(--text-muted);
            padding: 12px;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 400;
            cursor: pointer;
            transition: all 0.3s;
        }

        .method-btn.active {
            border-color: var(--gold-primary);
            color: var(--bg-color);
            background-color: var(--gold-primary);
        }

        .kvkk-wrapper {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 30px;
            font-size: 11px;
            font-weight: 300;
            color: var(--text-muted);
        }

        .kvkk-link {
            color: var(--gold-primary);
            text-decoration: underline;
            cursor: pointer;
        }

        .submit-btn {
            background-color: var(--gold-primary);
            color: #000;
            border: none;
            padding: 18px;
            font-size: 14px;
            font-weight: 500;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 4px;
            cursor: pointer;
            transition: opacity 0.3s;
            width: 100%;
        }

        .submit-btn:disabled {
            background-color: #333;
            color: #666;
            cursor: not-allowed;
        }

        /* --- MODALS (KVKK & PWA) --- */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: var(--bg-color);
            z-index: 10000;
            display: none;
            flex-direction: column;
            transform: translateX(100%);
            transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .modal.active {
            display: flex;
            transform: translateX(0);
        }

        .modal-header {
            padding: 20px;
            border-bottom: 1px solid #222;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .back-btn {
            background: none;
            border: none;
            color: var(--gold-primary);
            font-size: 24px;
            cursor: pointer;
        }

        .modal-title {
            font-size: 14px;
            font-weight: 400;
            letter-spacing: 1px;
        }

        .modal-body {
            flex: 1;
            padding: 20px;
            overflow-y: auto;
            font-size: 12px;
            line-height: 1.8;
            color: var(--text-muted);
            font-weight: 300;
        }

        .modal-footer {
            padding: 20px;
            border-top: 1px solid #222;
            background: var(--bg-color);
        }

        .accept-btn {
            width: 100%;
            padding: 16px;
            background-color: var(--gold-primary);
            color: #000;
            border: none;
            font-size: 14px;
            font-weight: 500;
            opacity: 0.3;
            cursor: not-allowed;
            transition: all 0.3s;
            border-radius: 4px;
        }

        /* PWA Success Modal */
        #pwa-modal {
            background-color: rgba(0,0,0,0.95);
            justify-content: center;
            align-items: center;
            padding: 30px;
            text-align: center;
        }
        
        .success-icon {
            width: 60px;
            fill: var(--gold-primary);
            margin-bottom: 20px;
        }

        .pwa-instruction {
            margin-top: 40px;
            padding: 20px;
            border: 1px solid var(--gold-dim);
            border-radius: 8px;
            background: rgba(212, 175, 55, 0.05);
        }
    </style>
</head>
<body>

    <!-- PRE-LOADER -->
    <div id="preloader">
        <svg class="jaguar-loader-svg" viewBox="0 0 100 50">
            <!-- Minimalist Jaguar/Panther Silhouette -->
            <path d="M10,40 Q15,30 25,32 Q35,20 50,25 Q70,20 85,30 Q95,35 90,40 Q80,35 65,40 Q50,45 35,40 Q20,45 10,40 Z" />
        </svg>
        <div class="loader-text">Sistem Hazırlanıyor</div>
    </div>

    <!-- STICKY HEADER & FILTERS -->
    <header class="header">
        <div class="header-title">Nasıl bir araba bakmıştınız? Lütfen seçiniz</div>
        <div class="filters-wrapper">
            <div class="filter-chip active">Premium SUV</div>
            <div class="filter-chip">Spor Sedan</div>
            <div class="filter-chip">Otomatik</div>
            <div class="filter-chip">Dizel</div>
            <div class="filter-chip">Elektrikli</div>
            <div class="filter-chip">7 Kişilik</div>
        </div>
    </header>

    <!-- MAIN SNAP SCROLL CONTAINER -->
    <div class="snap-container" id="main-scroll">

        <!-- SECTION 1: LÜKS ARAÇ (1-1) -->
        <section class="snap-section">
            <div class="car-container">
                <canvas class="canvas-360" id="canvas-car1"></canvas>
                <div class="car-details">
                    <div class="segment-jaguar">
                        <!-- Altın, Hızlı Jaguar -->
                        <svg class="segment-icon lux-jaguar" viewBox="0 0 100 50">
                            <path d="M10,40 Q15,30 25,32 Q35,20 50,25 Q70,20 85,30 Q95,35 90,40 Q80,35 65,40 Q50,45 35,40 Q20,45 10,40 Z" />
                        </svg>
                    </div>
                    <h2 class="brand-model">Mercedes G-Class</h2>
                    <div class="price-tag">4.500 <span class="price-currency">₺ / Gün</span></div>
                    
                    <div class="specs-grid">
                        <div class="spec-item">
                            <svg class="spec-icon" viewBox="0 0 24 24"><path d="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M11,19.93C7.05,19.43 4,16.05 4,12C4,7.95 7.05,4.57 11,4.07V19.93M13,4.07C16.95,4.57 20,7.95 20,12C20,16.05 16.95,19.43 13,19.93V4.07Z"/></svg>
                            <span class="spec-value">Otomatik</span>
                        </div>
                        <div class="spec-item">
                            <svg class="spec-icon" viewBox="0 0 24 24"><path d="M19.36,10.93L18.41,9.45C18.15,9.05 17.5,8.89 17.06,9.16L15.34,10.27C14.7,9.9 14,9.65 13.25,9.54V7.5C13.25,7.03 12.87,6.65 12.4,6.65H11.6C11.13,6.65 10.75,7.03 10.75,7.5V9.54C10,9.65 9.3,9.9 8.66,10.27L6.94,9.16C6.5,8.89 5.85,9.05 5.59,9.45L4.64,10.93C4.38,11.34 4.54,11.95 5,12.21L6.72,13.31C6.67,13.72 6.65,14.13 6.65,14.54C6.65,14.95 6.67,15.36 6.72,15.77L5,16.87C4.54,17.13 4.38,17.74 4.64,18.15L5.59,19.63C5.85,20.03 6.5,20.19 6.94,19.92L8.66,18.81C9.3,19.18 10,19.43 10.75,19.54V21.58C10.75,22.05 11.13,22.43 11.6,22.43H12.4C12.87,22.43 13.25,22.05 13.25,21.58V19.54C14,19.43 14.7,19.18 15.34,18.81L17.06,19.92C17.5,20.19 18.15,20.03 18.41,19.63L19.36,18.15C19.62,17.74 19.46,17.13 19,16.87L17.28,15.77C17.33,15.36 17.35,14.95 17.35,14.54C17.35,14.13 17.33,13.72 17.28,13.31L19,12.21C19.46,11.95 19.62,11.34 19.36,10.93M12,17.5A3,3 0 0,1 9,14.5A3,3 0 0,1 12,11.5A3,3 0 0,1 15,14.5A3,3 0 0,1 12,17.5Z"/></svg>
                            <span class="spec-value">Dizel</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: STANDART ARAÇ (1-1) -->
        <section class="snap-section">
            <div class="car-container">
                <canvas class="canvas-360" id="canvas-car2"></canvas>
                <div class="car-details">
                    <div class="segment-jaguar">
                        <!-- Gri, Yavaş Jaguar -->
                        <svg class="segment-icon std-jaguar" viewBox="0 0 100 50">
                            <path d="M10,40 Q15,30 25,32 Q35,20 50,25 Q70,20 85,30 Q95,35 90,40 Q80,35 65,40 Q50,45 35,40 Q20,45 10,40 Z" />
                        </svg>
                    </div>
                    <h2 class="brand-model">Volkswagen Passat</h2>
                    <div class="price-tag">2.100 <span class="price-currency">₺ / Gün</span></div>
                    
                    <div class="specs-grid">
                        <div class="spec-item">
                            <svg class="spec-icon" viewBox="0 0 24 24"><path d="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M11,19.93C7.05,19.43 4,16.05 4,12C4,7.95 7.05,4.57 11,4.07V19.93M13,4.07C16.95,4.57 20,7.95 20,12C20,16.05 16.95,19.43 13,19.93V4.07Z"/></svg>
                            <span class="spec-value">Otomatik</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 3: 2'Lİ KUTUCUK -->
        <section class="snap-section">
            <div class="dual-grid">
                <div class="dual-item">
                    <canvas class="dual-canvas" id="canvas-car3"></canvas>
                    <div class="dual-details">
                        <div class="dual-brand">Citroen C4</div>
                        <div class="dual-price">1.500 ₺</div>
                    </div>
                </div>
                <div class="dual-item">
                    <canvas class="dual-canvas" id="canvas-car4"></canvas>
                    <div class="dual-details">
                        <div class="dual-brand">Citroen C3</div>
                        <div class="dual-price">1.200 ₺</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 4: LEAD GENERATION FORM -->
        <section class="full-screen-section">
            <div class="lead-form-container">
                <div class="value-prop">
                    <div class="payment-icons">
                        <svg viewBox="0 0 24 24"><path d="M20,8H4V6H20M20,18H4V12H20M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"/></svg>
                        <svg viewBox="0 0 24 24"><path d="M11.8 10.9C9.53 10.31 8.8 9.7 8.8 8.75C8.8 7.66 9.81 6.9 11.5 6.9C13.28 6.9 13.94 7.75 14 9H16.29C16.14 7.04 14.6 5.28 12.5 4.73V2.5H10V4.71C8.07 5.08 6.5 6.38 6.5 8.77C6.5 11.45 8.61 12.64 12.2 13.54C14.71 14.17 15.2 15.08 15.2 16.18C15.2 17.06 14.41 18 11.5 18C8.94 18 7.97 16.92 7.79 15.5H5.5C5.73 17.86 7.46 19.33 10 19.82V22H12.5V19.85C14.54 19.5 17.5 18.23 17.5 16.13C17.5 13.06 14.91 11.71 11.8 10.9Z"/></svg>
                    </div>
                    <p>Aracınız şehir içi adresinize <span>ücretsiz olarak</span> getirilir, hiçbir ekstra ücret ödemezsiniz.</p>
                </div>

                <form id="reservation-form">
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Adınız Soyadınız" required>
                    </div>
                    <div class="form-group">
                        <input type="tel" class="form-input" placeholder="Telefon Numaranız" required>
                    </div>
                    <div class="row-grid">
                        <div class="form-group">
                            <input type="date" class="form-input" placeholder="Alış Tarihi" required>
                        </div>
                        <div class="form-group">
                            <input type="time" class="form-input" placeholder="Alış Saati" required>
                        </div>
                    </div>
                    <div class="row-grid">
                        <div class="form-group">
                            <input type="date" class="form-input" placeholder="Teslim Tarihi" required>
                        </div>
                        <div class="form-group">
                            <input type="time" class="form-input" placeholder="Teslim Saati" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <input type="text" class="form-input" placeholder="Teslim Edilecek İlçe" required>
                    </div>

                    <div class="contact-method">
                        <button type="button" class="method-btn active" data-method="call">Hemen Ara</button>
                        <button type="button" class="method-btn" data-method="message">Sadece Mesaj At</button>
                        <input type="hidden" id="contact-preference" value="call">
                    </div>

                    <div class="kvkk-wrapper">
                        <input type="checkbox" id="kvkk-checkbox" required disabled>
                        <label for="kvkk-checkbox">
                            <span class="kvkk-link" id="open-kvkk">KVKK & Kiralama Sözleşmesini</span> okudum ve onaylıyorum.
                        </label>
                    </div>

                    <button type="submit" class="submit-btn" id="main-submit" disabled>Talebi Gönder</button>
                </form>
            </div>
        </section>
    </div>

    <!-- KVKK MODAL -->
    <div class="modal" id="kvkk-modal">
        <div class="modal-header">
            <button class="back-btn" id="close-kvkk">←</button>
            <h3 class="modal-title">Kiralama Sözleşmesi ve KVKK Metni</h3>
        </div>
        <div class="modal-body" id="kvkk-content">
            <p><strong>1. TARAFLAR VE KONU</strong><br>
            İşbu sözleşme, Referans Rentecar ile aracı kiralayan müşteri arasındaki hak ve yükümlülükleri, aracın teslim ve iade şartlarını, hukuki sorumlulukları düzenler.
            <br><br>
            <strong>2. KULLANIM ŞARTLARI</strong><br>
            Müşteri, aracı trafik kurallarına uygun, özenle ve amacı doğrultusunda kullanmayı taahhüt eder. Araç, sözleşmede belirtilen kişi/kişiler dışında kullanılamaz. Olası trafik cezaları, HGS/OGS geçiş ücretleri ve araca verilecek kasıtlı zararlar tamamen müşterinin sorumluluğundadır.
            <br><br>
            <strong>3. SİGORTA VE KASKO DURUMU</strong><br>
            Araçlar standart kasko altındadır. Alkol, uyuşturucu madde etkisi altında veya yasal hız sınırlarının %50 üzerinde yapılan kazalarda tüm kasko hakları geçersiz sayılacak ve hasar rücu edilecektir.
            <br><br>
            <strong>4. KVKK AYDINLATMA METNİ</strong><br>
            Kişisel verileriniz (Ad, Soyad, Telefon, Lokasyon), 6698 sayılı Kişisel Verilerin Korunması Kanunu kapsamında, sadece araç kiralama operasyonunun yürütülmesi, tarafınıza hizmet sağlanması ve yasal zorunluluklar çerçevesinde işlenmektedir. Verileriniz 3. şahıslarla reklam amacıyla paylaşılmamaktadır.
            <br><br>
            <strong>5. TESLİMAT VE İADE</strong><br>
            Araç müşteri adresine ücretsiz teslim edilir ve iade alınır. Gecikme durumunda her saat için günlük kiralama bedelinin 1/3'ü talep edilir.
            <br><br><br><br>
            <i>(Onaylamak için metnin sonuna kadar okuyunuz...)</i>
            </p>
        </div>
        <div class="modal-footer">
            <button class="accept-btn" id="accept-kvkk" disabled>Okudum, Anladım</button>
        </div>
    </div>

    <!-- SUCCESS & PWA MODAL -->
    <div class="modal" id="pwa-modal">
        <svg class="success-icon" viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12S6.5 22 12 22 22 17.5 22 12 17.5 2 12 2M10 17L5 12L6.41 10.59L10 14.17L17.59 6.58L19 8L10 17Z"/></svg>
        <h2 style="color:var(--gold-primary); font-weight:300; margin-bottom:15px;">Talebiniz Alındı!</h2>
        <p style="font-size:14px; font-weight:300; line-height:1.6;">Müşteri temsilcimiz seçtiğiniz iletişim yöntemi ile en kısa sürede size ulaşacaktır.</p>
        
        <div class="pwa-instruction" id="pwa-instructions">
            <h3 style="color:#fff; font-size:13px; margin-bottom:10px;">Daha Hızlı İletişim İçin</h3>
            <p style="font-size:12px; color:var(--text-muted);" id="device-specific-text">
                Referans Rentecar uygulamasını ana ekranınıza ekleyin.
            </p>
            <button class="submit-btn" style="margin-top:20px; padding:12px; font-size:12px;" id="install-pwa-btn">Ana Ekrana Ekle</button>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            
            // --- 1. PRE-LOADER MANTIĞI (Minimum 2 saniye kuralı) ---
            const preloader = document.getElementById('preloader');
            setTimeout(() => {
                preloader.style.opacity = '0';
                setTimeout(() => preloader.style.display = 'none', 800);
            }, 2000);

            // --- 2. 360 DERECE CANVAS SİMÜLASYONU ---
            // Görsel dizisi (Image Sequence) altyapısı kurulmuştur.
            // Sunucuda görseller olmadığından, konsepti ispatlamak için render işlemi simüle edilmektedir.
            class Car360Viewer {
                constructor(canvasId, totalFrames = 36, textParam = "Model") {
                    this.canvas = document.getElementById(canvasId);
                    this.ctx = this.canvas.getContext('2d');
                    this.totalFrames = totalFrames;
                    this.currentFrame = 0;
                    this.isDragging = false;
                    this.startX = 0;
                    this.textParam = textParam;

                    this.resize();
                    window.addEventListener('resize', () => this.resize());
                    this.initEvents();
                    this.drawFrame();
                }

                resize() {
                    this.canvas.width = this.canvas.parentElement.clientWidth;
                    this.canvas.height = this.canvas.parentElement.clientHeight * 0.8;
                    this.drawFrame();
                }

                drawFrame() {
                    // Gerçek senaryoda: this.ctx.drawImage(images[this.currentFrame], 0, 0, width, height);
                    const w = this.canvas.width;
                    const h = this.canvas.height;
                    
                    this.ctx.clearRect(0, 0, w, h);
                    
                    // Araç yerine geçen premium çizgisel gösterim
                    this.ctx.strokeStyle = '#D4AF37';
                    this.ctx.lineWidth = 1;
                    
                    // Merkez çemberi
                    this.ctx.beginPath();
                    this.ctx.ellipse(w/2, h/2, w*0.3, h*0.15, 0, 0, Math.PI*2);
                    this.ctx.stroke();

                    // Simüle edilmiş 360 açı metni
                    this.ctx.fillStyle = '#E0E0E0';
                    this.ctx.font = '300 14px Montserrat';
                    this.ctx.textAlign = 'center';
                    const degree = Math.floor((this.currentFrame / this.totalFrames) * 360);
                    this.ctx.fillText(`360° Görünüm (${degree}°)`, w/2, h/2 - 20);
                    this.ctx.fillStyle = '#D4AF37';
                    this.ctx.font = '400 16px Montserrat';
                    this.ctx.fillText(this.textParam, w/2, h/2 + 10);
                    
                    // Kaydırma yönlendirmesi
                    this.ctx.fillStyle = '#888';
                    this.ctx.font = '200 10px Montserrat';
                    this.ctx.fillText("‹ Kaydırarak İncele ›", w/2, h/2 + 40);
                }

                initEvents() {
                    const handleStart = (e) => {
                        this.isDragging = true;
                        this.startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
                    };

                    const handleMove = (e) => {
                        if (!this.isDragging) return;
                        e.preventDefault(); // Dikey scroll'u engelle
                        const x = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
                        const dx = x - this.startX;
                        
                        // Hassasiyet ayarı
                        if (Math.abs(dx) > 10) {
                            if (dx > 0) {
                                this.currentFrame = (this.currentFrame + 1) % this.totalFrames;
                            } else {
                                this.currentFrame = (this.currentFrame - 1 + this.totalFrames) % this.totalFrames;
                            }
                            this.startX = x;
                            this.drawFrame();
                        }
                    };

                    const handleEnd = () => { this.isDragging = false; };

                    this.canvas.addEventListener('mousedown', handleStart);
                    this.canvas.addEventListener('mousemove', handleMove);
                    window.addEventListener('mouseup', handleEnd);

                    this.canvas.addEventListener('touchstart', handleStart, { passive: false });
                    this.canvas.addEventListener('touchmove', handleMove, { passive: false });
                    this.canvas.addEventListener('touchend', handleEnd);
                }
            }

            new Car360Viewer('canvas-car1', 36, "Referans Rentecar - G Class");
            new Car360Viewer('canvas-car2', 36, "Referans Rentecar - Passat");
            new Car360Viewer('canvas-car3', 36, "C4");
            new Car360Viewer('canvas-car4', 36, "C3");


            // --- 3. FİLTRE CAROUSEL MANTIĞI ---
            const filterChips = document.querySelectorAll('.filter-chip');
            filterChips.forEach(chip => {
                chip.addEventListener('click', () => {
                    filterChips.forEach(c => c.classList.remove('active'));
                    chip.classList.add('active');
                });
            });


            // --- 4. FORM VE İLETİŞİM TERCİHİ MANTIĞI ---
            const methodBtns = document.querySelectorAll('.method-btn');
            const contactPref = document.getElementById('contact-preference');
            
            methodBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    methodBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    contactPref.value = btn.getAttribute('data-method');
                });
            });


            // --- 5. KVKK VE SÖZLEŞME (SCROLL-TO-BOTTOM ONAYI) ---
            const kvkkModal = document.getElementById('kvkk-modal');
            const openKvkkBtn = document.getElementById('open-kvkk');
            const closeKvkkBtn = document.getElementById('close-kvkk');
            const kvkkContent = document.getElementById('kvkk-content');
            const acceptKvkkBtn = document.getElementById('accept-kvkk');
            const kvkkCheckbox = document.getElementById('kvkk-checkbox');
            const mainSubmitBtn = document.getElementById('main-submit');

            openKvkkBtn.addEventListener('click', () => kvkkModal.classList.add('active'));
            closeKvkkBtn.addEventListener('click', () => kvkkModal.classList.remove('active'));

            // Metin sonuna kaydırma kontrolü
            kvkkContent.addEventListener('scroll', () => {
                // scrollTop + clientHeight >= scrollHeight toleranslı kontrol
                if (kvkkContent.scrollTop + kvkkContent.clientHeight >= kvkkContent.scrollHeight - 10) {
                    acceptKvkkBtn.disabled = false;
                    acceptKvkkBtn.style.opacity = '1';
                    acceptKvkkBtn.style.cursor = 'pointer';
                }
            });

            acceptKvkkBtn.addEventListener('click', () => {
                kvkkCheckbox.checked = true;
                kvkkCheckbox.disabled = false;
                mainSubmitBtn.disabled = false;
                kvkkModal.classList.remove('active');
            });


            // --- 6. PWA VE BAŞARI DURUMU ---
            const form = document.getElementById('reservation-form');
            const pwaModal = document.getElementById('pwa-modal');
            const deviceSpecificText = document.getElementById('device-specific-text');
            const installBtn = document.getElementById('install-pwa-btn');
            let deferredPrompt;

            // Android Chrome PWA Yakalama
            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredPrompt = e;
            });

            form.addEventListener('submit', (e) => {
                e.preventDefault();
                // Form backend'e gönderildi varsayımı...
                pwaModal.classList.add('active');

                // iOS vs Android Kontrolü
                const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
                
                if (isIOS) {
                    deviceSpecificText.innerHTML = "Tarayıcınızın alt menüsündeki <b>Paylaş</b> butonuna basıp, açılan listeden <b>'Ana Ekrana Ekle'</b> seçeneğini seçerek uygulamamızı cihazınıza indirebilirsiniz.";
                    installBtn.style.display = 'none'; // iOS'ta otomatik buton çalışmaz.
                } else {
                    deviceSpecificText.innerHTML = "Aşağıdaki butona tıklayarak uygulamamızı ücretsiz olarak telefonunuza yükleyebilirsiniz.";
                    installBtn.addEventListener('click', async () => {
                        if (deferredPrompt) {
                            deferredPrompt.prompt();
                            const { outcome } = await deferredPrompt.userChoice;
                            deferredPrompt = null;
                        }
                    });
                }
            });
        });
    </script>
</body>
</html>
